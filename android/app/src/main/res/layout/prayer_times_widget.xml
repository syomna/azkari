<?xml version="1.0" encoding="utf-8"?>
<!--
  Home-screen prayer widget.

  Two rows inside a dark forest-green container. The prayer whose adhan is
  next gets an expanded mint card that spans two of the four grid columns and
  carries the live countdown; the other five get compact slots.

  Colours come from values/colors.xml and the five prayer icons from
  drawable/ic_prayer_*.xml, so the provider only has to swap the active
  card's background and text colours.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@drawable/widget_background"
    android:layoutDirection="rtl"
    android:textDirection="rtl">

    <!-- Header: Hijri date on the leading (right) edge, Gregorian trailing.
         Both come from the same day entry the prayer times are read from, so
         the date always matches the times below it. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="true"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/widget_hijri_date"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:paddingStart="@dimen/widget_card_padding_active"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="9sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text"
            android:includeFontPadding="false"
            tools:text="5 ربيع الآخر 1447 هـ" />

        <TextView
            android:id="@+id/widget_gregorian_date"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:paddingEnd="@dimen/widget_card_padding_compact"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="9sp"
            android:textColor="@color/widget_text_muted"
            android:includeFontPadding="false"
            tools:text="الثلاثاء 5 يناير 2026" />
    </LinearLayout>

    <!-- Row 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/prayer_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="0dp"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/widget_card_padding_compact"
            android:background="@drawable/widget_cell">

        <LinearLayout
            android:id="@+id/prayer_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/widget_card_padding_compact"
            android:background="@drawable/widget_cell">

            <ImageView
                android:id="@+id/prayer_2_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_prayer_sunrise"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/prayer_2_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textSize="8.5sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/widget_text_muted" />

            <TextView
                android:id="@+id/prayer_2_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:textColor="@color/widget_text" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/prayer_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/widget_card_padding_compact"
            android:background="@drawable/widget_cell">

            <ImageView
                android:id="@+id/prayer_3_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_prayer_sun"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/prayer_3_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textSize="8.5sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/widget_text_muted" />

            <TextView
                android:id="@+id/prayer_3_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:textColor="@color/widget_text" />

        </LinearLayout>

    </LinearLayout>

    <!-- Row 2: three compact slots -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/prayer_4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/widget_card_padding_compact"
            android:background="@drawable/widget_cell">

            <ImageView
                android:id="@+id/prayer_4_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_prayer_sun"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/prayer_4_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textSize="8.5sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/widget_text_muted" />

            <TextView
                android:id="@+id/prayer_4_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:textColor="@color/widget_text" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/prayer_5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/widget_card_padding_compact"
            android:background="@drawable/widget_cell">

            <ImageView
                android:id="@+id/prayer_5_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_prayer_sunset"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/prayer_5_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textSize="8.5sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/widget_text_muted" />

            <TextView
                android:id="@+id/prayer_5_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:textColor="@color/widget_text" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/prayer_6"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/widget_card_padding_compact"
            android:background="@drawable/widget_cell">

            <ImageView
                android:id="@+id/prayer_6_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_prayer_isha"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/prayer_6_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textSize="8.5sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/widget_text_muted" />

            <TextView
                android:id="@+id/prayer_6_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:textColor="@color/widget_text" />

        </LinearLayout>

    </LinearLayout>
    <!-- Countdown row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/widget_card_padding_compact"
        android:paddingVertical="4dp"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/widget_countdown_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="8.5sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_text_muted" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Chronometer
            android:id="@+id/widget_countdown_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format="%s"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:textColor="@color/widget_text" />
    </LinearLayout>

</LinearLayout>
</LinearLayout>
