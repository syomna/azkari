<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10dp"
        android:layoutDirection="rtl"
        android:textDirection="rtl">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <!-- Date -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_hijri_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:id="@+id/widget_gregorian_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textSize="9sp"
                    android:textColor="#80FFFFFF" />

            </LinearLayout>

            <!-- Next prayer -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:id="@+id/widget_next_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#D922A351" />

            </LinearLayout>

        </LinearLayout>

        <!-- First prayer row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <LinearLayout
                android:id="@+id/prayer_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="4dp"
                android:background="@drawable/prayer_cell_bg">

                <TextView
                    android:id="@+id/prayer_1_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textColor="#99FFFFFF" />

                <TextView
                    android:id="@+id/prayer_1_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#D922A351" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/prayer_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="4dp"
                android:background="@drawable/prayer_cell_bg">

                <TextView
                    android:id="@+id/prayer_2_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textColor="#99FFFFFF" />

                <TextView
                    android:id="@+id/prayer_2_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#D922A351" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/prayer_3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="4dp"
                android:background="@drawable/prayer_cell_bg">

                <TextView
                    android:id="@+id/prayer_3_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textColor="#99FFFFFF" />

                <TextView
                    android:id="@+id/prayer_3_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#D922A351" />

            </LinearLayout>

        </LinearLayout>

        <!-- Second prayer row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/prayer_4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="4dp"
                android:background="@drawable/prayer_cell_bg">

                <TextView
                    android:id="@+id/prayer_4_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textColor="#99FFFFFF" />

                <TextView
                    android:id="@+id/prayer_4_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#D922A351" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/prayer_5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="4dp"
                android:background="@drawable/prayer_cell_bg">

                <TextView
                    android:id="@+id/prayer_5_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textColor="#99FFFFFF" />

                <TextView
                    android:id="@+id/prayer_5_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#D922A351" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/prayer_6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="4dp"
                android:background="@drawable/prayer_cell_bg">

                <TextView
                    android:id="@+id/prayer_6_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textColor="#99FFFFFF" />

                <TextView
                    android:id="@+id/prayer_6_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#D922A351" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>